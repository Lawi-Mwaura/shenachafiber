# Server-only pooled Neon connection. Never prefix this value with NEXT_PUBLIC_.
# Without it, POST /api/leads returns 503 and the form truthfully reports that nothing was sent or stored.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Server-only direct Neon connection used by migrations. Never prefix with NEXT_PUBLIC_.
DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require

# Optional migration compatibility test connection. Use only a disposable Neon branch.
NEON_TEST_DATABASE_URL=postgresql://user:password@test-host/test-database?sslmode=require
